# PostgreSQL: used by the backend (native or in Docker) and by the `make db` development container.
# DATABASE_URL=postgresql+asyncpg://... overrides these if you need a non-standard connection string.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gamefleet
DB_USER=gamefleet
DB_PASSWORD=changeme

# Production deployment ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Frontend server options: node-server or nginx-server
FRONTEND_TARGET=node-server

# Dashboard login: comma-separated name:password pairs. Passwords may be plain text or scrypt hashes
# from `make hash` (escape every $ of a hash as $$ in this file). Leave empty to disable login (not recommended).
GAMEFLEET_USERS=admin:changeme
# Random string that signs login tokens; if empty, a new one is generated on every backend start (logs everyone out).
GAMEFLEET_SECRET=

# Docker discovery: import containers with known game-server images automatically (labelled ones always are).
DOCKER_AUTO_IMPORT=true
