# PostgreSQL: used by the backend (native or in Docker) and by the `make db` development container.
# Leave DB_HOST empty to use the Postgres published on this host: localhost for native dev,
# host.docker.internal for the backend container. Set it only for a database on another machine.
# DATABASE_URL=postgresql+asyncpg://... overrides these if you need a non-standard connection string.
DB_HOST=
DB_PORT=5432
DB_NAME=gamefleet
DB_USER=gamefleet
DB_PASSWORD=changeme

# Ports published on the host. The dashboard needs only FRONTEND_PORT (it forwards API calls to the backend);
# BACKEND_PORT exposes the API and its Swagger UI directly.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Dashboard login: comma-separated name:password pairs. Passwords may be plain text or scrypt hashes
# from `make hash` (escape every $ of a hash as $$ in this file). Visitors who are not signed in only see the
# servers marked public. Leave empty to disable login and make everyone an admin (not recommended).
GAMEFLEET_USERS=admin:changeme
# Random string that signs login tokens; if empty, a new one is generated on every backend start (logs everyone out).
GAMEFLEET_SECRET=
