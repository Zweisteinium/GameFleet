# true: API docs at /swagger, verbose logs, dev banner; without users everyone is admin. Not for production.
GAMEFLEET_DEV=false

# Postgres. Empty DB_HOST = the database on this host (also for `make db`). DATABASE_URL overrides all.
DB_HOST=
DB_PORT=5432
DB_NAME=gamefleet
DB_USER=gamefleet
DB_PASSWORD=changeme

# Host ports. Browsers need only the frontend; the backend port exposes the API.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Without login: public servers only.
# name:password,name2:password2 (plain or `make hash`; write $ as $$). Empty: nobody can sign in, read-only.
GAMEFLEET_USERS=admin:changeme
# Signs login tokens. Empty: regenerated on every start, which logs everyone out.
GAMEFLEET_SECRET=
