# true: API docs at /swagger, verbose logs, dev banner; without users everyone is admin. Not for production.
GAMEFLEET_DEV=false

# Postgres. Empty DB_HOST = the postgres service of docker-compose.yml (`make db`); DB_PORT is then the port it
# is published on for native development (`make backend`). DATABASE_URL overrides all.
DB_HOST=
DB_PORT=5432
DB_NAME=gamefleet
DB_USER=gamefleet
DB_PASSWORD=changeme

# Host ports. Browsers need only the frontend. The backend and the database are published on 127.0.0.1 only;
# BACKEND_BIND / DB_BIND change that, FRONTEND_BIND limits the frontend to one address (e.g. the LAN one).
BACKEND_PORT=8000
FRONTEND_PORT=3000
# FRONTEND_BIND=0.0.0.0
# Reverse proxy in front of the frontend (address or CIDR, comma-separated): its X-Forwarded-For is believed,
# so failed sign-ins are counted per browser instead of all together.
TRUSTED_PROXIES=

# Without login: public servers only. Signing in takes the password and a code from an authenticator app,
# set up at the first sign-in (`make reset-2fa U=name` removes a lost one).
# name:password,name2:password2 (plain or `make hash`; write $ as $$). Empty: nobody can sign in, read-only.
GAMEFLEET_USERS=admin:changeme
# Required with users: signs sign-ins and derives the authenticator keys. Changing it signs everyone out and
# invalidates every authenticator. Generate one with: openssl rand -hex 32
GAMEFLEET_SECRET=
# Hours a sign-in lasts.
GAMEFLEET_SESSION_HOURS=24
# Address of the dashboard as browsers reach it, for the links of `make invite` (e.g. https://games.example.com).
GAMEFLEET_URL=

# Host folder that new game servers are created in, as <folder>/<game>/<name>/. Mounted into the backend at the
# same path; the Settings page uses it as the default.
GAMEFLEET_SERVERS_DIR=/srv/gameservers
